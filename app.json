{
  "expo": {
    "name": "WolfKey",
    "slug": "wolfkey-mobile",
    "scheme": "wolfkey",
    "version": "1.8.1",
    "orientation": "portrait",
    "icon": "./assets/light-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/WolfKeyIcon.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.hugoc1000.wolfkeymobile",
      "buildNumber": "33",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.hugoc1000.wolfkeymobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "translucent": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "We use your photo library to let you upload profile photos, share images in posts, and import a photo of your class schedule.",
          "cameraPermission": "We use your camera to let you take profile photos, share images in posts, and photograph your class schedule for import."
        }
      ],
      "expo-font",
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e33a2ce5-4211-437c-8175-c313f7d6a90c"
      }
    },
    "owner": "hugoc1000"
  }
}
